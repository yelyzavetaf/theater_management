<odoo>
    <data>
        <record id="module_category_theater" model="ir.module.category">
            <field name="name">Theater Management</field>
            <field name="description">Helps manage theater performances and troupe.</field>
            <field name="sequence">1</field>
        </record>

        <record id="privilege_theater_management" model="res.groups.privilege">
            <field name="name">Theater management</field>
            <field name="category_id" ref="theater_management.module_category_theater"/>
            <field name="sequence">10</field>
            <field name="description">User access levels for Theater Management</field>
        </record>

        <record id="group_theater_user" model="res.groups">
            <field name="name">User</field>
            <field name="privilege_id" ref="privilege_theater_management"/>
            <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
            <field name="comment">Users of Theater management</field>
        </record>

        <record id="group_theater_manager" model="res.groups">
            <field name="name">Administrator</field>
            <field name="privilege_id" ref="privilege_theater_management"/>
            <field name="implied_ids" eval="[Command.link(ref('theater_management.group_theater_user'))]"/>
            <field name="user_ids" eval="[Command.link(ref('base.user_root', 'base.user_admin'))]"/>
            <field name="comment">Administrators of Theater management (full rights)</field>
        </record>
    </data>
</odoo>
