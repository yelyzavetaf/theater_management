<odoo>
    <data noupdate="1">
        <!-- Regular users can only read published events-->
        <record id="rule_event_user_published_only" model="ir.rule">
            <field name="name">Theater User: Published Events Only</field>
            <field name="model_id" ref="event.model_event_event"/>
            <field name="groups" eval="[Command.link(ref('theater_management.group_theater_user'))]"/>
            <field name="domain_force">[('is_published', '=', True)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Administrator sees all events -->
        <record id="rule_event_admin_all" model="ir.rule">
            <field name="name">Theater Admin: All Events</field>
            <field name="model_id" ref="event.model_event_event"/>
            <field name="groups" eval="[Command.link(ref('theater_management.group_theater_manager'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>
    </data>
</odoo>