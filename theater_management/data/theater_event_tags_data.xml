<odoo>
    <data noupdate="1">
        <!-- Category of tags -->
        <record id="theater_event_tag_category" model="event.tag.category">
            <field name="name">Theater Genre</field>
        </record>

        <!-- Tags inside the category -->
        <record id="theater_event_tag_opera" model="event.tag">
            <field name="name">Opera</field>
            <field name="category_id" ref="theater_event_tag_category"/>
            <field name="color" eval="1"/>
        </record>

        <record id="theater_event_tag_ballet" model="event.tag">
            <field name="name">Ballet</field>
            <field name="category_id" ref="theater_event_tag_category"/>
            <field name="color" eval="2"/>
        </record>

        <record id="theater_event_tag_violin" model="event.tag">
            <field name="name">Violin</field>
            <field name="category_id" ref="theater_event_tag_category"/>
            <field name="color" eval="3"/>
        </record>

        <record id="theater_event_tag_classical" model="event.tag">
            <field name="name">Classical</field>
            <field name="category_id" ref="theater_event_tag_category"/>
            <field name="color" eval="4"/>
        </record>

        <record id="theater_event_tag_folk" model="event.tag">
            <field name="name">Folk</field>
            <field name="category_id" ref="theater_event_tag_category"/>
            <field name="color" eval="5"/>
        </record>

        <record id="theater_event_tag_dance" model="event.tag">
            <field name="name">Dance</field>
            <field name="category_id" ref="theater_event_tag_category"/>
            <field name="color" eval="6"/>
        </record>

        <record id="theater_event_tag_modern" model="event.tag">
            <field name="name">Modern</field>
            <field name="category_id" ref="theater_event_tag_category"/>
            <field name="color" eval="7"/>
        </record>
    </data>
</odoo>