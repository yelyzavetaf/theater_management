<odoo>

    <record id="theater_musician_list" model="ir.ui.view">
        <field name="name">theater.musician.list ()</field>
        <field name="model">theater.musician</field>
        <field name="arch" type="xml">
            <list string="Musicians">
                <field name="full_name"/>
                <field name="sex" optional="hide"/>
                <field name="age" optional="hide"/>
                <field name="instrument_id"/>
                <field name="experience" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="theater_musician_form" model="ir.ui.view">
        <field name="name">theater.musician.form</field>
        <field name="model">theater.musician</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="first_name" string="Full name"/>
                        <h1 class="d-flex gap-2">
                            <field name="last_name" placeholder="Last name"/>
                            <field name="first_name" placeholder="First name"/>
                            <field name="middle_name" placeholder="Middle name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="General information">
                            <field name="sex"/>
                            <field name="birth_date"/>
                            <field name="age"/>
                            <field name="joined_date"/>
                            <field name="experience"/>
                            <field name="instrument_id"/>
                        </group>
                        <group string="Contact information">
                            <field name="phone_number"/>
                            <field name="email"/>
                            <field name="country_id"/>
                            <field name="language_id"/>
                        </group>
                    </group>
<!--                        <notebook>-->
