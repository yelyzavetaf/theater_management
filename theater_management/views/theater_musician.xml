<!--                                        <field name="assigned_date"/>-->
<!--                                        <field name="reassigned_date"/>-->
<!--                                        <field name="reassigned_reason" optional="show"/>-->
<!--                                    </list>-->
<!--                                </field>-->
<!--                            </page>-->
<!--                        </notebook>-->
                </sheet>
            </form>
        </field>
    </record>

        <record id="theater_musician_search" model="ir.ui.view">
            <field name="name">theater.musician.search</field>
            <field name="model">theater.musician</field>
            <field name="arch" type="xml">
                <search string="Search musician">
                    <field name="full_name" string="Musician's Name" filter_domain="[('full_name', 'ilike', self)]"/>
                </search>
            </field>
        </record>

        <record id="action_theater_musician_window" model="ir.actions.act_window">
            <field name="name">Musician</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">theater.musician</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem id="theater_menu_musician"
                  action="action_theater_musician_window"
                  parent="theater_menu_staff"
                  name="Musicians" sequence="400"/>

</odoo>