<odoo>
    <record id="view_event_form_inherit_theater_combined" model="ir.ui.view">
        <field name="name">event.event.form.theater.combined</field>
        <field name="model">event.event</field>
        <field name="inherit_id" ref="event.view_event_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="before">
                <!-- Це поле автоматично оновить фонову картинку на сайті -->
                <field name="image_1920" widget="image" class="oe_avatar"
                       options="{'preview_image': 'image_128'}"/>
            </xpath>
            <!-- Додаємо вибір типу у верхню частину форми -->
<!--            <xpath expr="//field[@name='date_end']" position="after">-->
<!--                <field name="event_type_selection" widget="radio" options="{'horizontal': true}"/>-->
<!--            </xpath>-->

            <!-- Приховуємо вкладку квитків, якщо обрано 'rehearsal' -->
<!--            <xpath expr="//page[@name='tickets']" position="attributes">-->
<!--                <attribute name="invisible">event_type_selection == 'rehearsal'</attribute>-->
<!--            </xpath>-->

            <!-- Також приховуємо кнопку 'Tickets' у верхній панелі (Smart Button), якщо вона є -->
<!--            <xpath expr="//div[@name='button_box']" position="inside">-->
<!--                <style>-->
<!--                    .o_stat_button[name="action_show_tickets"] {-->
<!--                        display: odoo-dynamic; /* Odoo керує видимістю через атрибути */-->
<!--                    }-->
<!--                </style>-->
<!--            </xpath>-->
            <xpath expr="//field[@name='date_end']" position="after">
                <field name="event_type_selection" widget="radio" options="{'horizontal': true}"/>
                <group string="Theater Logistics" >
                    <field name="has_actors" widget="boolean_toggle"/>
                    <field name="has_orchestra" widget="boolean_toggle"/>

<!--                    <field name="image_1920" widget="image" class="oe_avatar"-->
<!--                        options="{'preview_image': 'image_128'}"/>-->
                </group>
            </xpath>
<!--            <xpath expr="//field[@name='name']" position="before">-->
<!--                <field name="kanban_image" widget="image" class="oe_avatar"/>-->
<!--            </xpath>-->

            <xpath expr="//notebook" position="inside">
            <!-- Вкладка Актори: видима тільки якщо це НЕ репетиція ТА стоїть галочка has_actors -->
            <page string="Cast &amp; Roles" name="theater_cast"
                  invisible="not has_actors">
                <field name="show_role_ids">
                    <list editable="bottom">
                        <field name="performer_type"/>
                        <field name="artist_id" options="{'no_create': True}"/>
                        <field name="role_name"/>
                    </list>
                </field>
            </page>

             Вкладка Оркестр: видима тільки якщо стоїть галочка has_orchestra
            <page string="Orchestra" name="theater_orchestra"
                  invisible="not has_orchestra">
                <field name="orchestra_ids">
                    <list editable="bottom">
                        <field name="instrument_id" options="{'no_create': True}"/>
                        <field name="musician_id" options="{'no_create': True}"/>
                    </list>
                </field>
            </page>
        </xpath>

        <!-- 3. Ховаємо стандартні квитки для репетицій -->
        <xpath expr="//page[@name='tickets']" position="attributes">
            <attribute name="invisible">event_type_selection == 'rehearsal'</attribute>
        </xpath>
        <xpath expr="//header/button[@name='961']" position="attributes">
            <attribute name="invisible">event_type_selection == 'rehearsal' or not seats_taken</attribute>
        </xpath>
<!--            <xpath expr="//page[@name='theater_cast']" position="attributes">-->
<!--                <attribute name="invisible">not has_actors</attribute>-->
<!--            </xpath>-->

<!--            <xpath expr="//page[@name='theater_orchestra']" position="attributes">-->
<!--                <attribute name="invisible">not has_orchestra</attribute>-->

        </field>
    </record>

    <record id="action_theater_events" model="ir.actions.act_window">
        <field name="name">Shows &amp; Rehearsals</field>
        <field name="res_model">event.event</field>
        <field name="view_mode">calendar,list,form,kanban</field>
        <!-- Початковий фільтр: за замовчуванням показувати календар -->
        <field name="view_id" ref="event.view_event_calendar"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Schedule your first show or rehearsal!
            </p>
        </field>
    </record>



    <menuitem id="theater_menu_events"
              name="Events"
              action="action_theater_events"
              parent="theater_menu_planning"
              sequence="10"/>

</odoo>