<odoo>
    <record id="view_event_form_inherit_theater_combined" model="ir.ui.view">
        <field name="name">event.event.form.theater.combined</field>
        <field name="model">event.event</field>
        <field name="inherit_id" ref="event.view_event_form"/>
        <field name="arch" type="xml">

            <!-- Wizard button-->
            <xpath expr="//header" position="inside">
                <button name="%(action_event_scheduler_wizard)d"
                        string="Schedule Multiple"
                        type="action"
                        class="btn-secondary"/>
            </xpath>

            <!-- Custom Event fields-->
            <xpath expr="//field[@name='date_end']" position="after">
                <field name="event_type_selection" widget="radio" options="{'horizontal': true}"/>
                <group string="Event Details">
                    <field name="details"/>
                    <field name="has_actors" widget="boolean_toggle"/>
                    <field name="has_orchestra" widget="boolean_toggle"/>
                    <field name="image_1920" widget="image" class="oe_avatar"
                       options="{'preview_image': 'image_128'}" string="Event banner"/>
                    <field name="is_published" widget="boolean_toggle"/>
                </group>
            </xpath>
            <xpath expr="//field[@name='lang']" position="before">
                <label for="lang" string="Event language"/>
            </xpath>

            <xpath expr="//page[@name='tickets']" position="before">
                <!-- Cast is visible only when has_actors is True -->
                <page string="Cast &amp; Roles" name="theater_cast"
                      invisible="not has_actors">
                    <field name="show_role_ids" context="{'default_event_id': id}">
                        <list editable="bottom">
                            <field name="performer_type"/>
                            <field name="artist_id" options="{'no_create': True}"/>
                            <field name="role_name"/>
                        </list>
                    </field>
                </page>

                <!-- Orchestra is visible only when has_orchestra is True-->
                <page string="Orchestra" name="theater_orchestra"
                      invisible="not has_orchestra">
                    <field name="orchestra_ids" context="{'default_event_id': id}">
                        <list editable="bottom">
                            <field name="instrument_id" options="{'no_create': True}"/>
                            <field name="musician_id" options="{'no_create': True}"/>
                        </list>
                    </field>
                </page>
            </xpath>

            <!-- Hiding tickets for rehearsals -->
            <xpath expr="//page[@name='tickets']" position="attributes">
                <attribute name="invisible">event_type_selection == 'rehearsal'</attribute>
            </xpath>
            <xpath expr="//header/button[@name='961']" position="attributes">
                <attribute name="invisible">event_type_selection == 'rehearsal' or not seats_taken</attribute>
            </xpath>

            <!-- Hiding not used fields-->
            <xpath expr="//field[@name='date_tz']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='event_type_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//label[@for='is_multi_slots']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//div[hasclass('o_row')][field[@name='is_multi_slots']]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//label[@for='website_menu']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='website_menu']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

    <record id="action_theater_events" model="ir.actions.act_window">
        <field name="name">Shows &amp; Rehearsals</field>
        <field name="res_model">event.event</field>
        <field name="view_mode">calendar,list,form,kanban</field>
        <field name="view_id" ref="event.view_event_calendar"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Schedule your first show or rehearsal!
            </p>
        </field>
    </record>

    <menuitem id="theater_menu_events"
              name="Events"
              action="action_theater_events"
              parent="theater_main_menu"
              sequence="5"/>

</odoo>
