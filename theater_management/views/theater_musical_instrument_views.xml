<odoo>

    <record id="view_theater_musical_instrument_list" model="ir.ui.view">
        <field name="name">theater.musical.instrument.list</field>
        <field name="model">theater.musical.instrument</field>
        <field name="arch" type="xml">
            <list string="Musical Instruments">
                <field name="name"/>
                <field name="category" widget="badge"
                       decoration-info="category == 'strings'"
                       decoration-success="category == 'woodwinds'"
                       decoration-warning="category == 'brass'"
                       decoration-danger="category == 'percussion'"/>
                <field name="number_of_musicians"/>
            </list>
        </field>
    </record>

    <record id="view_theater_musical_instrument_form" model="ir.ui.view">
        <field name="name">theater.musical.instrument.form</field>
        <field name="model">theater.musical.instrument</field>
        <field name="arch" type="xml">
            <form string="Musical Instrument">
                <sheet>

                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" placeholder="e.g. Cello"/>
                        </h1>
                    </div>

                    <group>
                        <group>
                            <field name="category"/>
                            <field name="number_of_musicians"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Musicians" name="musicians">
                            <field name="musician_ids">
                                <list>
                                    <field name="full_name"/>
                                    <field name="experience"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_theater_musical_instrument_search" model="ir.ui.view">
        <field name="name">theater.musical.instrument.search</field>
        <field name="model">theater.musical.instrument</field>
        <field name="arch" type="xml">
            <search string="Search Instruments">
                <field name="name"/>
                <field name="category"/>
            </search>
        </field>
    </record>

    <record id="action_theater_musical_instrument_window" model="ir.actions.act_window">
            <field name="name">Musical Instruments</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">theater.musical.instrument</field>
            <field name="view_mode">list,form</field>
    </record>

    <menuitem id="theater_menu_musical_instrument"
              action="action_theater_musical_instrument_window"
              parent="theater_menu_planning"
              name="Musical Instruments" sequence="502"/>

</odoo>
