<odoo>

    <record id="theater_artist_list" model="ir.ui.view">
        <field name="name">theater.artist.list ()</field>
        <field name="model">theater.artist</field>
        <field name="arch" type="xml">
            <list string="Artists">
                <field name="full_name"/>
                <field name="sex" optional="hide"/>
                <field name="age" optional="hide"/>
                <field name="performer_type"/>
                <field name="experience" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="theater_artist_form" model="ir.ui.view">
        <field name="name">theater.artist.form</field>
        <field name="model">theater.artist</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="first_name" string="Full name"/>
                        <h1 class="d-flex gap-2">
                            <field name="last_name" placeholder="Last name"/>
                            <field name="first_name" placeholder="First name"/>
                            <field name="middle_name" placeholder="Middle name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="General information">
                            <field name="sex"/>
                            <field name="birth_date"/>
                            <field name="age"/>
                            <field name="joined_date"/>
                            <field name="experience"/>
                            <field name="performer_type"/>
                            <field name="dance_style"
                                   invisible="performer_type != 'dancer'"
                                   required="performer_type == 'dancer'"/>

                        </group>
                        <group string="Contact information">
                            <field name="phone_number"/>
                            <field name="email"/>
                            <field name="country_id"/>
                            <field name="language_id"/>
                        </group>
                    </group>
<!--                        <notebook>-->
<!--                            <page name="diagnosis_history" string="Diagnoses history">-->
<!--                                <field name="diagnosis_ids">-->
<!--                                    <list create="0" edit="0" delete="0">-->
<!--                                        <field name="disease_id"/>-->
<!--                                        <field name="description"/>-->
<!--                                        <field name="approved"/>-->
<!--                                        <field name="approved_by" optional="hide"/>-->
<!--                                        <field name="approved_date" optional="hide"/>-->
<!--                                        <field name="severity"/>-->
<!--                                    </list>-->
<!--                                </field>-->
<!--                            </page>-->

<!--                            <page name="doctors_history" string="Doctors history">-->
<!--                                <field name="doctor_history_ids" context="{'active_test': False}">-->
<!--                                    <list create="0" edit="0" delete="0">-->
<!--                                        <field name="doctor_history_id"/>-->
<!--                                        <field name="active" column_invisible="True"/>-->
<!--                                        <field name="assigned_date"/>-->
<!--                                        <field name="reassigned_date"/>-->
<!--                                        <field name="reassigned_reason" optional="show"/>-->
<!--                                    </list>-->
<!--                                </field>-->
<!--                            </page>-->
<!--                        </notebook>-->
                </sheet>
            </form>
        </field>
    </record>

    <record id="theater_artist_search" model="ir.ui.view">
        <field name="name">theater.artist.search</field>
        <field name="model">theater.artist</field>
        <field name="arch" type="xml">
            <search string="Search artist">
                <field name="full_name" string="Artist's Name" filter_domain="[('full_name', 'ilike', self)]"/>
            </search>
        </field>
    </record>

    <record id="action_theater_artist_window" model="ir.actions.act_window">
        <field name="name">Artist</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">theater.artist</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="theater_menu_artist"
              action="action_theater_artist_window"
              parent="theater_menu_staff"
              name="Artists" sequence="301"/>

</odoo>